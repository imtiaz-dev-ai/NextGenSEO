# Environment Configuration
VITE_API_URL=https://api.nextgenseo.com
VITE_CONTACT_EMAIL=tayyab@nextgenseo.pro
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_LOGGING=false
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_BACKLINKS=true

# ============================================
# AI TOOL APIS (Server-side only - NEVER prefix with VITE_)
# ============================================
# These are used by serverless functions and must NOT be exposed to the browser.
# Set them in your hosting dashboard (Netlify/Vercel env vars), not in .env.local

# OpenAI - https://platform.openai.com/api-keys  ($5 free credit on signup)
OPENAI_API_KEY=

# Serper - https://serper.dev/api-key  (2,500 FREE queries/month)
SERPER_API_KEY=

# Google PageSpeed Insights - https://developers.google.com/speed/docs/insights/v5/get-started
# NOTE: Works WITHOUT a key too (just lower rate limit). Optional.
PAGESPEED_API_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Admin Credentials
VITE_ADMIN_USERNAME=nextgenadmin
VITE_ADMIN_PASSWORD=NextGen@2025
