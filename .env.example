# Environment Configuration
# Copy this to .env.local and update with your values

# API Endpoints
VITE_API_URL="https://api.nextgenseo.com"

# Email Configuration
VITE_CONTACT_EMAIL="nextgenseotool@gmail.com"

# Security
VITE_ENABLE_ANALYTICS="true"
VITE_ENABLE_LOGGING="false"

# Feature Flags
VITE_ENABLE_ADMIN_PANEL="true"
VITE_ENABLE_BACKLINKS="true"

# Admin Credentials
VITE_ADMIN_USERNAME="nextgenadmin"
VITE_ADMIN_PASSWORD="NextGen@2025"
