# Environment Configuration
VITE_API_URL=https://api.nextgenseo.com
VITE_CONTACT_EMAIL=tayyab@nextgenseo.pro
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_LOGGING=false
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_BACKLINKS=true

# ============================================
# AI TOOL APIS (Server-side only - NEVER prefix with VITE_)
# ============================================
# These are used by serverless functions and must NOT be exposed to the browser.
# Set them in your hosting dashboard (Netlify/Vercel env vars), not in .env.local

# OpenAI - https://platform.openai.com/api-keys  ($5 free credit on signup)
OPENAI_API_KEY=

# Serper - https://serper.dev/api-key  (2,500 FREE queries/month)
SERPER_API_KEY=

# Google PageSpeed Insights - https://developers.google.com/speed/docs/insights/v5/get-started
# NOTE: Works WITHOUT a key too (just lower rate limit). Optional.
PAGESPEED_API_KEY=

# ============================================
# SUPABASE — DATABASE AND IMAGE STORAGE
# ============================================
# Get the URL and publishable key from Supabase Dashboard -> Project Settings -> API Keys.
#
# The publishable key is used in the browser. Never use a secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://bckkbkodjpotcjkfedds.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key
VITE_SUPABASE_BUCKET=images

# Server-side Vercel environment variables (admin API and one-time migration).
# Set these in Vercel; do not prefix with VITE_ or expose them to the browser.
SUPABASE_URL=https://bckkbkodjpotcjkfedds.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
SUPABASE_STORAGE_BUCKET=images
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=use_a_long_unique_password
ADMIN_SESSION_SECRET=generate_a_random_secret_at_least_32_bytes

# One-time local Firestore -> Supabase migration only.
GOOGLE_APPLICATION_CREDENTIALS=D:\private\firebase-source-service-account.json
