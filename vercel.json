{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api|assets|pics|fonts|favicon|robots|sitemap|privacy|schema|google|sw\\.js|llms\\.txt|about|team|blog|contact|pricing|case_studies|service_|buy-backlinks|marketplace|free_audit_page|community|tool_|admin).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nextgenseo.pro" }],
      "destination": "https://www.nextgenseo.pro/:path*",
      "permanent": true
    },
    { "source": "/marketplace", "destination": "/buy-backlinks", "permanent": true },
    { "source": "/marketplace/", "destination": "/buy-backlinks", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Vary", "value": "Accept-Encoding" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/pics/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "env": {
    "VITE_ENABLE_ANALYTICS": "true",
    "VITE_ENABLE_LOGGING": "false",
    "VITE_ENABLE_BACKLINKS": "true"
  }
}
